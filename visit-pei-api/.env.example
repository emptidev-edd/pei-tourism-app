# Copy to .env (API) / .env.docker (docker compose) and fill in real values.

NODE_ENV=development
PORT=4000

# Postgres connection used by Prisma
DATABASE_URL=postgresql://changeme:changeme@localhost:5433/changeme?schema=public

# PEI 511 Developer Key (required for most calls)
PEI511_KEY=changeme

# RSS feeds to ingest (comma-separated)
RSS_FEEDS=https://www.princeedwardisland.ca/en/news/rss-feeds

# Visitor centres page (HTML scrape)
VIC_LIST_URL=https://www.tourismpei.com/about-pei/visitor-information-centres
VIC_BASE_URL=https://www.tourismpei.com

# Optional: run ingestion on startup
RUN_INGEST_ON_BOOT=false

# Transitland API key (required for transit data calls)
TRANSITLAND_API_KEY=changeme

# Admin API key for /api/admin/* routes (generate with: openssl rand -hex 32)
ADMIN_API_KEY=changeme

# Docker compose (.env.docker) — postgres container credentials
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme
