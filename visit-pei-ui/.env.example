# TickitUp SA API (Nest). This is the only backend for the Expo app.
#
# Physical iPhone/Android on the same Wi-Fi: use your computer LAN IP.
# localhost on a phone is the phone itself, so fetch will fail.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
#
# Physical device on the same Wi-Fi: replace with your computer's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.4.38:4000
#
# Android emulator only:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
#
# Google Maps SDK for Android. Required for maps in a development or store build.
# Do not commit the real key. Expo Go on Android cannot show Google Maps.
# After setting this, rebuild with: npx expo run:android
GOOGLE_MAPS_ANDROID_API_KEY=
